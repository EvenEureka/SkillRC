#!/bin/bash
#$ -N papero_s5_post
#$ -q gpu@@tarikan_lab
#$ -l gpu_card=1
#$ -pe smp 1
#$ -cwd
#$ -o logs/
#$ -e logs/

set -euo pipefail

kinit -R 2>/dev/null || true
aklog || true

ROOT=${SKILLRC_ROOT}
PY=${SKILLRC_PY}
cd "$ROOT"
mkdir -p logs

"$PY" scripts/analyze_missing_prompt_completion.py
"$PY" scripts/validate_papero_executor_moderation.py

echo "[Paper O missing-prompt postprocess complete]"
