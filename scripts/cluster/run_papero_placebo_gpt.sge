#!/bin/bash
#$ -N po_pl_gpt
# The tarikan_lab GPU queue requires a GPU resource even though this API run is CPU-bound.
#$ -q gpu@@tarikan_lab
#$ -l gpu_card=1
#$ -pe smp 4
#$ -cwd
#$ -o logs/
#$ -e logs/

set -euo pipefail
kinit -R 2>/dev/null || true
aklog || true

ROOT=${SKILLRC_ROOT}
PY=${SKILLRC_PY}
cd "$ROOT"
mkdir -p logs
export ALFWORLD_DATA="$ROOT/data/alfworld"

if [ -f "$HOME/.skillrc.env" ]; then
  set -a
  source "$HOME/.skillrc.env"
  set +a
fi
: "${OPENAI_API_KEY:?OPENAI_API_KEY must be configured in ~/.skillrc.env}"

for output in results/PAPERO_PLACEBO_GPT.episodes.jsonl results/PAPERO_PLACEBO_GPT.summary.json; do
  if [ -e "$output" ]; then
    echo "refusing to overwrite existing output: $output"
    exit 2
  fi
done

PYTHONPATH=. "$PY" scripts/build_order_placebo.py
"$PY" -m skillrc.runner --config configs/papero_placebo_gpt.yaml
