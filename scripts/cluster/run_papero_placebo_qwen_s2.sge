#!/bin/bash
#$ -N po_pl_qs2
#$ -q gpu@@tarikan_lab
#$ -l gpu_card=1
#$ -pe smp 8
#$ -cwd
#$ -o logs/
#$ -e logs/

set -euo pipefail
kinit -R 2>/dev/null || true
aklog || true
ROOT=${SKILLRC_ROOT}
cd "$ROOT"
mkdir -p logs
export ALFWORLD_DATA="$ROOT/data/alfworld"
VLLM=${VLLM_ENV}
export HF_HOME=${HF_HOME}
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
export CUDA_HOME=$VLLM/lib/python3.11/site-packages/nvidia/cu13
export PATH=$VLLM/bin:$CUDA_HOME/bin:$PATH
export VLLM_ATTENTION_BACKEND=FLASH_ATTN VLLM_USE_FLASHINFER_SAMPLER=0
test ! -e results/PAPERO_PLACEBO_QWEN_S2.episodes.jsonl
test ! -e results/PAPERO_PLACEBO_QWEN_S2.summary.json
JOB=${JOB_ID:-$$}
PORT=$((9000 + JOB % 1000))
SRVLOG="logs/vllm_placebo_s2.$JOB.log"
"$VLLM/bin/vllm" serve Qwen/Qwen3-8B --served-model-name qwen3-8b --port "$PORT" \
  --gpu-memory-utilization 0.85 --max-model-len 16384 --enforce-eager > "$SRVLOG" 2>&1 &
SRV_PID=$!
cleanup() { kill "$SRV_PID" 2>/dev/null || true; sleep 3; kill -9 "$SRV_PID" 2>/dev/null || true; }
trap cleanup EXIT
ready=0
for i in $(seq 1 144); do
  if curl -sf "http://localhost:$PORT/health" >/dev/null 2>&1; then ready=1; break; fi
  if ! kill -0 "$SRV_PID" 2>/dev/null; then tail -30 "$SRVLOG"; exit 1; fi
  sleep 5
done
test "$ready" -eq 1
PY=${SKILLRC_PY}
"$PY" -m skillrc.runner --config configs/papero_placebo_qwen_s2.yaml \
  --override base_url=http://localhost:$PORT/v1
