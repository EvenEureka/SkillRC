<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Gate report: {{ res.spec.name }}</title>
<style>
:root{--bg:#fbfaf8;--fg:#1d1d1b;--muted:#6b6b66;--line:#e3e1dc;--card:#ffffff;--code:#f3f2ee;
--pass:#1f7a4d;--pass-bg:#e6f3ec;--block:#b3261e;--block-bg:#fbe9e7;--inc:#8a6100;--inc-bg:#fbf1dc;
--inv:#5b3f99;--inv-bg:#efe9fa;--desc:#3f5f8a;--desc-bg:#e8eef7;--accent:#2f5d9e}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#161615;--fg:#ecebe7;--muted:#a3a29c;
--line:#33332f;--card:#1f1f1d;--code:#262624;--pass:#6fcf97;--pass-bg:#173326;--block:#f2847c;--block-bg:#3a1d1a;
--inc:#e5b85c;--inc-bg:#3a2f15;--inv:#b9a3ee;--inv-bg:#2b2340;--desc:#92b4e3;--desc-bg:#1c2738;--accent:#8db3ea}}
:root[data-theme="dark"]{--bg:#161615;--fg:#ecebe7;--muted:#a3a29c;--line:#33332f;--card:#1f1f1d;--code:#262624;
--pass:#6fcf97;--pass-bg:#173326;--block:#f2847c;--block-bg:#3a1d1a;--inc:#e5b85c;--inc-bg:#3a2f15;--inv:#b9a3ee;
--inv-bg:#2b2340;--desc:#92b4e3;--desc-bg:#1c2738;--accent:#8db3ea}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font:15px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
main{max-width:1080px;margin:0 auto;padding:28px 16px 64px}
h1{font-size:22px;margin:0 0 4px}h2{font-size:17px;margin:34px 0 10px;border-bottom:1px solid var(--line);padding-bottom:6px}
h3{font-size:15px;margin:18px 0 6px}.sub{color:var(--muted);margin:0 0 18px}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:16px 18px;margin:14px 0}
.badge{display:inline-block;font-weight:700;font-size:13px;letter-spacing:.04em;padding:3px 10px;border-radius:999px}
.PASS{color:var(--pass);background:var(--pass-bg)}.BLOCK{color:var(--block);background:var(--block-bg)}
.INCONCLUSIVE{color:var(--inc);background:var(--inc-bg)}.INVALID{color:var(--inv);background:var(--inv-bg)}
.DESCRIPTIVE{color:var(--desc);background:var(--desc-bg)}
.head{display:flex;gap:12px;align-items:center;flex-wrap:wrap}.head .name{font-weight:700;font-size:16px}
.kv{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:8px 18px;margin:12px 0}
.kv div span{display:block;color:var(--muted);font-size:12px}.kv div b{font-variant-numeric:tabular-nums}
table{border-collapse:collapse;width:100%;font-size:13.5px;font-variant-numeric:tabular-nums}
th,td{text-align:left;padding:5px 8px;border-bottom:1px solid var(--line);vertical-align:top}th{color:var(--muted);font-weight:600}
.scroll{overflow-x:auto}ul.reasons{margin:6px 0 0 18px;padding:0;color:var(--muted);font-size:13.5px}
.flag{color:var(--inc);font-size:13.5px;margin-top:6px}
svg.iv{width:100%;height:auto;margin-top:8px}svg.iv .lab,svg.iv .reflab{fill:var(--muted);font-size:12px}
svg.iv .bar{stroke:var(--fg);stroke-width:3;stroke-linecap:round}svg.iv .dot{fill:var(--fg)}
svg.iv .bar.block{stroke:var(--block)}svg.iv .dot.block{fill:var(--block)}svg.iv .bar.pass{stroke:var(--pass)}
svg.iv .dot.pass{fill:var(--pass)}svg.iv .bar.inconclusive,svg.iv .bar.descriptive{stroke:var(--inc)}
svg.iv .dot.inconclusive,svg.iv .dot.descriptive{fill:var(--inc)}svg.iv .bar.muted{stroke:var(--muted)}svg.iv .dot.muted{fill:var(--muted)}
svg.iv .ref{stroke:var(--line);stroke-width:1.5}svg.iv .ref.margin{stroke:var(--block);stroke-dasharray:4 3}
.note{font-size:13px;color:var(--muted);border-left:3px solid var(--line);padding-left:10px;margin:8px 0}
.replay{display:grid;grid-template-columns:1fr 1fr;gap:12px}@media (max-width:760px){.replay{grid-template-columns:1fr}}
.traj{font:12.5px/1.45 ui-monospace,SFMono-Regular,Menlo,monospace;background:var(--code);border-radius:8px;padding:8px 10px;overflow-x:auto}
.traj .s{padding:2px 0;border-bottom:1px dashed var(--line);white-space:pre-wrap;word-break:break-word}
.traj .s.div{background:var(--inc-bg)}.traj .n{color:var(--muted);display:inline-block;width:2.2em}
details summary{cursor:pointer;color:var(--accent)}code{background:var(--code);padding:1px 5px;border-radius:4px;font-size:12.5px}
</style>
</head>
<body>
<main>
<h1>{{ res.spec.name }}</h1>
<p class="sub">{{ res.spec.description }} · skillrc-gate {{ res.tool.version }} · {{ res.spec.bootstrap_draws }} bootstrap draws, seed {{ res.spec.seed }}, one-sided α = {{ res.spec.alpha }}</p>

<h2>Release targets</h2>
{% for name, t in res.targets.items() %}
{% set det = t.details %}
<div class="card" id="target-{{ name }}">
  <div class="head"><span class="badge {{ t.state }}">{{ t.state }}</span><span class="name">{{ name }}{% if name == selected %} · selected{% endif %}</span>
  <span class="sub" style="margin:0">{{ t.description }}</span></div>
  {% if det.primary %}
  <div class="kv">
    <div><span>candidate</span><b>{{ det.candidate }}</b></div>
    <div><span>baseline</span><b>{{ det.baseline }}</b></div>
    <div><span>{{ det.primary.metric }}: candidate / baseline</span><b>{{ det.primary.candidate_mean|f(3,false) }} / {{ det.primary.baseline_mean|f(3,false) }}</b></div>
    <div><span>Δ [95% interval]</span><b>{{ det.primary.pessimistic.estimate|f }} [{{ det.primary.pessimistic.lower|f }}, {{ det.primary.optimistic.upper|f }}]</b></div>
    <div><span>margin δ</span><b>{{ det.primary.margin }}</b></div>
    <div><span>tasks (strata)</span><b>{{ det.n_tasks }} ({{ det.strata|length }})</b></div>
  </div>
  {{ charts[name].primary|safe }}
  {% endif %}
  {% for f in t.flags %}<div class="flag">⚑ {{ f }}</div>{% endfor %}
  <ul class="reasons">{% for r in t.reasons %}<li>{{ r }}</li>{% endfor %}</ul>
  {% if det.guardrails %}
  <h3>Guardrails</h3>
  <div class="scroll"><table><tr><th>guardrail</th><th>estimate</th><th>95% interval</th><th>tolerance</th><th>note</th></tr>
  {% for g in det.guardrails %}<tr><td><code>{{ g.name }}</code></td>
  <td>{{ (g.estimate.estimate if g.estimate else none)|pct }}</td>
  <td>{% if g.estimate %}[{{ g.estimate.lower|pct }}, {{ g.estimate.upper|pct }}]{% else %}–{% endif %}</td>
  <td>{{ g.tolerance|pct }}</td><td>{{ g.note }}</td></tr>{% endfor %}</table></div>
  {{ charts[name].guard|safe }}
  {% endif %}
  {% if det.primary and det.primary.margin_sensitivity %}
  <p class="note">Margin sensitivity (primary component): {% for r in det.primary.margin_sensitivity %}δ = {{ r.margin }} → {{ r.primary_component }}{% if not loop.last %}; {% endif %}{% endfor %}</p>
  {% endif %}
  {% if det.power %}
  <details><summary>Power at this design (normal approximation)</summary>
  <p class="note">{{ det.power.note }}. n = {{ det.power.n_tasks }}, paired SD = {{ det.power.paired_sd|f(3,false) }}, SE = {{ det.power.se|f(4,false) }}, MDE (80%, two-sided 0.05) = {{ det.power["mde_80_two_sided_0.05"]|f(3,false) }}.</p>
  <table><tr><th>assumed true Δ</th><th>P(PASS)</th><th>P(BLOCK)</th></tr>
  {% for r in det.power.rows %}<tr><td>{{ r.true_effect|f }}</td><td>{{ r.p_pass|pct }}</td><td>{{ r.p_block|pct }}</td></tr>{% endfor %}</table>
  </details>
  {% endif %}
  {% if det.blocks and det.blocks.blocks %}
  <details><summary>Execution blocks</summary>
  <p class="note">{{ det.blocks.note }}</p>
  <table><tr><th>contrast</th><th>Δ</th><th>95% interval</th><th>tasks</th></tr>
  {% for k, v in det.blocks.per_block.items() %}{% if v %}<tr><td>block {{ k }}</td><td>{{ v.estimate|f }}</td><td>[{{ v.lower|f }}, {{ v.upper|f }}]</td><td>{{ v.n_tasks }}</td></tr>{% endif %}{% endfor %}
  {% if det.blocks.block_difference %}{% set v = det.blocks.block_difference %}<tr><td>Δ₂ − Δ₁</td><td>{{ v.estimate|f }}</td><td>[{{ v.lower|f }}, {{ v.upper|f }}]</td><td>{{ v.n_tasks }}</td></tr>{% endif %}
  </table></details>
  {% endif %}
</div>
{% endfor %}

{% if res.contrasts %}
<h2>Diagnostic and descriptive contrasts</h2>
<div class="card">
<div class="scroll"><table><tr><th>contrast</th><th>candidate − baseline</th><th>role</th><th>Δ</th><th>95% interval</th><th>claim</th><th>supported</th><th>evaluable</th></tr>
{% for n, c in res.contrasts.items() %}<tr><td><b>{{ n }}</b><br><span class="sub">{{ c.description }}</span></td><td>{{ c.candidate }} − {% if c.baseline is string %}{{ c.baseline }}{% else %}mean({{ c.baseline|join(", ") }}){% endif %}{% if c.pairing == "same_block" %} (same block){% endif %}</td><td>{{ c.role }}</td>
<td>{{ c.estimate.estimate|f if c.estimate else "–" }}</td><td>{% if c.estimate %}[{{ c.estimate.lower|f }}, {{ c.estimate.upper|f }}]{% else %}–{% endif %}</td>
<td>{% if c.claim != "none" %}Δ {{ ">" if c.claim == "greater" else "<" }} {{ c.threshold }}{% else %}–{% endif %}</td>
<td>{{ c.supported if c.supported is defined else "–" }}</td><td>{{ c.evaluable }}{% for r in c.reasons %}<br><span class="sub">{{ r }}</span>{% endfor %}</td></tr>{% endfor %}
</table></div>
{{ contrast_chart|safe }}
{% for n, cl in res.claims.items() %}<p><b>Claim {{ n }}</b>: {{ cl.description }} — evaluable: {{ cl.evaluable }}, holds: <b>{{ cl.holds }}</b>. <span class="sub">{{ cl.rule }}</span></p>{% endfor %}
</div>
{% endif %}

{% for name, t in res.targets.items() %}{% set b = t.details.behaviour %}
{% if b and b.actions_per_episode %}
<h2>Behaviour shift · {{ name }}</h2>
<div class="card"><p class="note">{{ b.note }}</p>
<div class="replay"><div><h3>Actions per episode</h3><table><tr><th>action</th><th>cand.</th><th>base.</th><th>Δ [95%]</th></tr>
{% for r in b.actions_per_episode[:8] %}<tr><td><code>{{ r.key }}</code></td><td>{{ r.candidate|f(2,false) }}</td><td>{{ r.baseline|f(2,false) }}</td><td>{{ r.diff_estimate|f(2) }} [{{ r.diff_lower|f(2) }}, {{ r.diff_upper|f(2) }}]</td></tr>{% endfor %}</table></div>
<div><h3>Episode outcomes</h3><table><tr><th>outcome</th><th>cand.</th><th>base.</th><th>Δ [95%]</th></tr>
{% for r in b.outcomes %}<tr><td><code>{{ r.key }}</code></td><td>{{ r.candidate|pct }}</td><td>{{ r.baseline|pct }}</td><td>{{ r.diff_estimate|f(3) }} [{{ r.diff_lower|f(3) }}, {{ r.diff_upper|f(3) }}]</td></tr>{% endfor %}</table></div></div>
</div>
{% endif %}
{% if t.details.replays %}
<h2>Paired replays · {{ name }}</h2>
<p class="note">Chosen by a fixed rule (first tasks by id where the baseline scored higher, plus random pairs with a fixed seed), not by hand. Highlighted: the first step where the two actions differ.</p>
{% for rp in t.details.replays %}
<div class="card"><div class="head"><span class="name">task {{ rp.task_id }} · {{ rp.task_type }}</span><span class="sub" style="margin:0">{{ rp.why }} · first divergence at step {{ rp.first_divergent_step }}</span></div>
<div class="replay">{% for side in ["baseline", "candidate"] %}{% set e = rp[side] %}
<div><h3>{{ side }} · score {{ e.score|f(2,false) }} · {{ e.steps }} steps{% if e.latency_s %} · {{ e.latency_s|f(1,false) }} s{% endif %}</h3>
<div class="traj">{% for s in e.trajectory %}<div class="s{% if s.step == rp.first_divergent_step %} div{% endif %}"><span class="n">{{ s.step }}</span>{{ s.action }}</div>{% endfor %}</div></div>
{% endfor %}</div></div>
{% endfor %}
{% endif %}
{% endfor %}

<h2>Coverage</h2>
<div class="card scroll"><table><tr><th>arm</th><th>attempts</th><th>expected cells</th><th>scored</th><th>missing</th><th>infra-failed</th><th>status</th></tr>
{% for n, c in res.coverage.items() %}<tr><td><b>{{ n }}</b></td><td>{{ c.attempts }}</td><td>{{ c.expected_cells if c.expected_cells is not none else "not declared" }}</td><td>{{ c.scored_cells }}</td><td>{{ c.missing_cells }}</td><td>{{ c.infra_failed_cells }}</td>
<td>{% for r in c.invalid %}<span class="badge INVALID">invalid</span> {{ r }}<br>{% endfor %}{% for r in c.descriptive %}<span class="sub">{{ r }}</span><br>{% endfor %}{% if not c.invalid and not c.descriptive %}release-eligible{% endif %}</td></tr>{% endfor %}
</table></div>

<h2>How to read this</h2>
{% for nt in res.notes %}<p class="note">{{ nt }}</p>{% endfor %}
<p class="note">Verdicts: PASS = lower bound of Δ above −δ and every guardrail's upper bound below its tolerance; BLOCK = upper bound of Δ below −δ, or a Holm-confirmed guardrail violation; INCONCLUSIVE = neither; INVALID = the evidence fails a validity check; DESCRIPTIVE = logs lack the provenance a release decision needs. A CI job should pass only on PASS.</p>
</main>
</body>
</html>
